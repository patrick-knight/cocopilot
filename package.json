{
  "name": "cocopilot",
  "version": "0.1.0",
  "description": "CoCoPilot - Collaborative Copilot Orchestration Platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=23.0.0"
  },
  "bin": {
    "coco": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "vite build",
    "dev": "tsc --watch",
    "dev:frontend": "vite",
    "start": "node dist/cli/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest tests/e2e/",
    "test:e2e:ui": "npx playwright test",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist/ dist-web/",
    "version": "npm run build && git add -A",
    "postversion": "git push && git push --tags"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.2.1",
    "@types/eventsource": "^3.0.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "dockerode": "^4.0.10",
    "eventsource": "^4.1.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ioredis": "^5.10.1",
    "node-cron": "^4.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/ink": "^2.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "test-exclude": "^8.0.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.5"
  },
  "license": "MIT",
  "overrides": {
    "rollup": "^4.59.0"
  }
}
