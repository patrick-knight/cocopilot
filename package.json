{
  "name": "cocopilot",
  "version": "0.1.0",
  "description": "CoCoPilot - Collaborative Copilot Orchestration Platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=23.0.0"
  },
  "bin": {
    "coco": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "vite build",
    "dev": "tsc --watch",
    "dev:frontend": "vite",
    "start": "node dist/cli/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest tests/e2e/",
    "test:e2e:ui": "npx playwright test",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist/ dist-web/"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.1.19",
    "commander": "^14.0.2",
    "cors": "^2.8.6",
    "dockerode": "^4.0.9",
    "express": "^5.2.1",
    "ioredis": "^5.9.2",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "license": "MIT"
}
